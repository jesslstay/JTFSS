# Copy to config.env and fill in. config.env is git-ignored — never commit your stream key.

# YouTube Studio → Go Live → Stream → "Stream key"
YT_STREAM_KEY=xxxx-xxxx-xxxx-xxxx-xxxx

# Primary ingest. Use rtmps://a.rtmps.youtube.com/live2 for encrypted RTMP.
YT_RTMP_URL=rtmp://a.rtmp.youtube.com/live2

# Which file to stream on loop (built by `make master`)
STREAM_FILE=build/fireplace_master_1h.mp4

# copy   = stream the pre-encoded file as-is (near-zero CPU, recommended)
# encode = re-encode on the fly at constant bitrate (more CPU, extra robust)
STREAM_MODE=copy

# Length of the broadcast in hours. 24 = one 24-hour fireplace, then stop.
# Leave empty or 0 to stream forever (24/7).
DURATION_HOURS=24
